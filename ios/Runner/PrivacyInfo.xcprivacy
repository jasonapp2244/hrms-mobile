<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple's privacy manifest. Required for App Store submission, and it has to
  agree with the privacy nutrition labels filled in on App Store Connect and
  with /privacy on the server — three descriptions of the same thing, and a
  reviewer will compare them.

  This file IS in the Xcode project: it is a PBXFileReference in the Runner
  group and a PBXBuildFile in the Runner target's Copy Bundle Resources phase
  (ids F1A2B3C41D00000000000001 and ...02 in project.pbxproj). A file in the
  folder is not in the bundle, and for a long time this one only sat in the
  folder — Apple rejects on submission when the manifest is absent, and nothing
  about it fails at build time, so the gap was silent.

  If the Runner target is ever recreated from scratch, re-add it: open
  ios/Runner.xcworkspace, drag PrivacyInfo.xcprivacy into the Runner group, and
  tick the Runner target so it lands in Copy Bundle Resources. Verify with
  `unzip -l Runner.app` on a built archive — the manifest must be at the bundle
  root.

  What is declared and why:

  Tracking is false. The app has no advertising SDK, no analytics, and never
  shares anything with a third party — the only host it talks to is the
  employer's own server.

  Location IS listed, as precise: B2.3 shipped and the app reads a fix through
  `geolocator` at the moment of a punch and sends it with the punch. It declares
  ACCESS_FINE_LOCATION on Android and NSLocationWhenInUseUsageDescription on
  iOS, which is precise rather than coarse whatever the user then grants — the
  declaration describes what is asked for, not what is given.

  This entry was missing for a while after B2.3 shipped, which is exactly the
  failure the comment above it warned about. An app that collects location
  without declaring it is the single most common cause of an enforcement
  removal, and nothing about it fails at build time.

  NSPrivacyAccessedAPITypes is empty: the app's own code uses no required-reason
  API. The plugins that do (Firebase, path_provider) ship their own manifests,
  which Xcode merges at build time.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Shown on the profile screen and used to address notifications. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The sign-in identifier, and where leave decisions are emailed. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Employee record: staff number, department, job title, reporting line. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Read at the moment of a punch and sent with it (B2.3). Never in the
		     background: there is no NSLocationAlwaysAndWhenInUseUsageDescription
		     and no ACCESS_BACKGROUND_LOCATION, and a punch that arrives without
		     a coordinate is recorded anyway. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Crashes the app did not survive (B6.5): the exception, a truncated
		     message and a stack trace, sent to the employer's own server and to
		     nowhere else. Linked, because a report delivered after sign-in
		     carries the token and is attributed. There is no crash SDK and no
		     analytics SDK here, which is what keeps NSPrivacyTracking false. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Punch times, worked hours and leave records — the point of the app. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
