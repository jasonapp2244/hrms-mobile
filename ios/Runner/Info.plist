<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- What appears under the icon on the home screen. Kept short: iOS
	     truncates past roughly 12 characters, and "HR & Attendance" would
	     render as "HR & Atten...". -->
	<key>CFBundleDisplayName</key>
	<string>HR Attendance</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>HR Attendance</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Shown verbatim in the iOS permission dialog. iOS terminates the app on
	     the spot if a location is requested without this key, so its absence is
	     a crash rather than a refusal — and only on a device, never in the
	     simulator flows a developer tends to test.

	     App Review reads this string against what the app actually does, so it
	     says why rather than just asking. "When in use" only: there is no
	     NSLocationAlwaysAndWhenInUseUsageDescription, because the app reads the
	     position at the moment of a punch and at no other time. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is recorded with each clock in and clock out, so your employer can confirm where attendance was logged. It is only read at the moment you tap the button, never in the background.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- App Store Connect asks about export compliance on every single upload
	     unless this is declared. The app's only cryptography is HTTPS to its own
	     server and the system keychain, both of which are exempt under the
	     standard exemption, so the answer is false and does not change. Declaring
	     it here removes a manual question from every release.

	     This stops being true the moment the app implements its own encryption
	     rather than using the platform's. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- No ATS exception is declared on purpose. The default blocks plain HTTP,
	     which is what we want for a release build; the http://10.0.2.2 used in
	     development is reached by dart:io, which does not consult ATS at all. -->
</dict>
</plist>
