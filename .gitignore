# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. A keystore in version control can sign a malicious update
# that Play accepts as genuine, and the passwords sit alongside it.
/android/key.properties
*.jks
*.keystore

# Firebase client configuration, per project rather than per developer.
# Not a secret in the way the service-account key is — these identify the app,
# they do not authorise sending — but they tie a build to one Firebase project
# and are reissued from the console, so they are placed rather than committed.
# See Push-Notifications_Setup.md.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Generated from lib/l10n/*.arb by gen_l10n, on `flutter pub get` and on every
# build. Build output, not source: a committed copy goes stale the moment a
# string is added without regenerating, and the symptom is a missing
# translation at runtime rather than an error at compile time.
/lib/l10n/generated/

# gen_l10n's report of what app_es.arb has not translated yet. Regenerated on
# every build; `flutter test` reads it and fails when it is not empty.
/lib/l10n/untranslated.json
