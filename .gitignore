# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. A keystore in version control can sign a malicious update
# that Play accepts as genuine, and the passwords sit alongside it.
/android/key.properties
*.jks
*.keystore

# Firebase client configuration, per project rather than per developer.
# Not a secret in the way the service-account key is — these identify the app,
# they do not authorise sending — but they tie a build to one Firebase project
# and are reissued from the console, so they are placed rather than committed.
# See Push-Notifications_Setup.md.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
